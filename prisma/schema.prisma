model SiteSettings {
  id          String   @id @default("site-settings")
  siteName    String?  @map("site_name")
  siteUrl     String?  @map("site_url")
  siteDescription String? @map("site_description")
  contactEmail String? @map("contact_email")
  postsPerPage Int?    @default(10) @map("posts_per_page")
  enableComments Boolean @default(true) @map("enable_comments")
  enableReactions Boolean @default(true) @map("enable_reactions")
  enableSharing Boolean @default(true) @map("enable_sharing")
  moderationRequired Boolean @default(true) @map("moderation_required")
  maintenanceMode Boolean @default(false) @map("maintenance_mode")
  socialLinks Json?   @map("social_links")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

