generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOCAL")
}

model User {
  userId                  String                   @id @map("user_id")
  username                String                   @unique
  password                String?
  email                   String                   @unique
  name                    String?
  bio                     String?
  avatarUrl               String?                  @map("avatar_url")
  role                    Role                     @default(USER)
  status                  UserStatus               @default(ACTIVE)
  canPost                 Boolean                  @default(false) @map("can_post")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  createdBy               String?                  @map("created_by")
  updatedBy               String?                  @map("updated_by")
  emailVerified           Boolean                  @default(false) @map("email_verified")
  phone                   String?
  deletedAt               DateTime?                @map("deleted_at")
  deletedBy               String?                  @map("deleted_by")
  Comment                 Comment[]
  Content                 Content[]
  courseRatings           CourseRating[]           @relation("CourseRatings")
  coursesCreated          Course[]                 @relation("CourseCreatedBy")
  coursesTaught           Course[]                 @relation("CourseInstructor")
  coursesUpdated          Course[]                 @relation("CourseUpdatedBy")
  followers               Follow[]                 @relation("UserFollowedBy")
  followings              Follow[]                 @relation("UserFollows")
  MfaTotp                 MfaTotp?
  NotificationDigest      NotificationDigest[]
  NotificationPreference  NotificationPreference[]
  Notifications           Notifications[]
  OauthIdentity           OauthIdentity[]
  PushToken               PushToken[]
  Reaction                Reaction[]
  Share                   Share[]
  supportMessages         SupportMessage[]
  supportRatings          SupportRating[]
  supportTickets          SupportTicket[]
  toolMarketingRatings    ToolMarketingRating[]    @relation("ToolMarketingRatings")
  toolMarketingsCreated   ToolMarketing[]          @relation("ToolMarketingCreatedBy")
  toolMarketingsTaught    ToolMarketing[]          @relation("ToolMarketingInstructor")
  toolMarketingsUpdated   ToolMarketing[]          @relation("ToolMarketingUpdatedBy")
  ToolRating              ToolRating[]             @relation("ToolRatings")
  userCourseUsages        UserCourseUsage[]
  userSavedCourses        UserSavedCourse[]
  userSavedToolMarketings UserSavedToolMarketing[]
  userSavedTools          UserSavedTool[]
  UserSettings            UserSettings?
  userToolMarketingUsages UserToolMarketingUsage[]
  userToolUsages          UserToolUsage[]

  @@map("users")
}

model OauthIdentity {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")
  user           User         @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([provider])
  @@map("oauth_identities")
}

model MfaTotp {
  userId         String   @id @map("user_id")
  secretEnc      String   @map("secret_enc")
  isEnabled      Boolean  @default(false) @map("is_enabled")
  backupCodesEnc String?  @map("backup_codes_enc")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")
  user           User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("mfa_totp")
}

model Follow {
  followerId String   @map("follower_id")
  followedId String   @map("followed_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")
  followed   User     @relation("UserFollowedBy", fields: [followedId], references: [userId], onDelete: Cascade)
  follower   User     @relation("UserFollows", fields: [followerId], references: [userId], onDelete: Cascade)

  @@id([followerId, followedId])
  @@unique([followerId, followedId])
  @@index([followedId])
  @@map("follows")
}

model Price {
  id             String          @id @default(cuid())
  name           String          @unique
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      String          @map("created_by")
  updatedBy      String?         @map("updated_by")
  deletedAt      DateTime?       @map("deleted_at")
  deletedBy      String?         @map("deleted_by")
  tools          AiTool[]        @relation("AiToolPrice")
  courses        Course[]        @relation("CoursePrice")
  toolMarketings ToolMarketing[] @relation("ToolMarketingPrice")

  @@map("prices")
}

model AiTool {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  homepageUrl  String?         @map("homepage_url")
  logoUrl      String?         @map("logo_url")
  shortDesc    String?         @map("short_desc")
  longDesc     String?         @map("long_desc")
  avgRating    Decimal?        @default(0.0) @map("avg_rating")
  ratingsCount Int             @default(0) @map("ratings_count")
  useCount     Int             @default(0) @map("use_count")
  seo          Json?           @map("seo")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  createdBy    String?         @map("created_by")
  updatedBy    String?         @map("updated_by")
  description  String          @default("")
  bodyHtml     String?
  status       Int             @default(1)
  priceId      String          @map("price_id")
  deletedAt    DateTime?       @map("deleted_at")
  deletedBy    String?         @map("deleted_by")
  price        Price           @relation("AiToolPrice", fields: [priceId], references: [id])
  audiences    ToolAudience[]
  ratings      ToolRating[]
  tags         ToolTag[]
  savedTools   UserSavedTool[] @relation("ToolSavedBy")
  usages       UserToolUsage[] @relation("ToolUsages")

  @@map("ai_tools")
}

model ToolRating {
  id                String    @id @default(cuid())
  toolId            String    @map("tool_id")
  userId            String    @map("user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  comment           String?
  contentQuality    Int?      @map("content_quality")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")
  feedback          String?
  instructorQuality Int?      @map("instructor_quality")
  learningOutcome   Int?      @map("learning_outcome")
  materialsQuality  Int?      @map("materials_quality")
  stars             Int
  tool              AiTool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user              User      @relation("ToolRatings", fields: [userId], references: [userId], onDelete: Cascade)

  @@index([toolId])
  @@index([userId])
  @@index([toolId, userId])
  @@map("tool_ratings")
}

model ToolTag {
  id        String    @id @default(cuid())
  toolId    String    @map("tool_id")
  tagId     String    @map("tag_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tool      AiTool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, tagId])
  @@index([tagId])
  @@map("tool_tags")
}

model Tag {
  id         String       @id @default(cuid())
  name       String       @unique
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  createdBy  String?      @map("created_by")
  updatedBy  String?      @map("updated_by")
  deletedAt  DateTime?    @map("deleted_at")
  deletedBy  String?      @map("deleted_by")
  ContentTag ContentTag[]
  toolTags   ToolTag[]

  @@map("tags")
}

model Audience {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String?        @map("created_by")
  updatedBy String?        @map("updated_by")
  deletedAt DateTime?      @map("deleted_at")
  deletedBy String?        @map("deleted_by")
  tools     ToolAudience[]

  @@map("audiences")
}

model ToolAudience {
  id         String    @id @default(cuid())
  toolId     String    @map("tool_id")
  audienceId String    @map("audience_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  audience   Audience  @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  tool       AiTool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, audienceId])
  @@index([toolId])
  @@index([audienceId])
  @@map("tool_audiences")
}

model UserToolUsage {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  toolId     String   @map("tool_id")
  usageCount Int      @default(1) @map("usage_count")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")
  tool       AiTool   @relation("ToolUsages", fields: [toolId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
  @@index([lastUsedAt])
  @@map("user_tool_usages")
}

model UserSavedTool {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  toolId    String   @map("tool_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  tool      AiTool   @relation("ToolSavedBy", fields: [toolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
  @@map("user_saved_tools")
}

model Categories {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  group          CategoryGroup    @default(ALL) @map("group")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      String?         @map("created_by")
  updatedBy      String?         @map("updated_by")
  deletedAt      DateTime?       @map("deleted_at")
  deletedBy      String?         @map("deleted_by")
  courses        Course[]        @relation("CourseCategory")
  posts          Post[]
  toolMarketings ToolMarketing[] @relation("ToolMarketingCategory")

  @@index([group])
  @@map("categories")
}

model Content {
  id             String         @id @default(cuid())
  kind           ContentKind
  authorId       String
  status         ContentType    @default(DRAFT)
  viewsCount     Int            @default(0)
  reactionsCount Int            @default(0)
  sharesCount    Int            @default(0)
  commentsCount  Int            @default(0)
  scheduledAt    DateTime?      @map("scheduled_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  createdBy      String?        @map("created_by")
  updatedBy      String?        @map("updated_by")
  deletedAt      DateTime?      @map("deleted_at")
  deletedBy      String?        @map("deleted_by")
  tags           ContentTag[]
  author         User           @relation(fields: [authorId], references: [userId], onDelete: Cascade)
  post           Post?
  ScheduledJob   ScheduledJob[]
  statusFeed     StatusFeed?

  @@index([authorId])
  @@index([status])
  @@index([authorId, status])
  @@map("contents")
}

model Post {
  id           String                @id @default(cuid())
  contentId    String                @unique @map("content_id")
  title        String
  slug         String                @unique
  coverImageId String?               @map("cover_image_id")
  bodyHtml     String?
  status       ContentType           @default(DRAFT)
  categoryId   String?               @map("category_id")
  seo          Json?
  excerpt      String?               @map("excerpt")
  authorName   String?               @map("author_name")
  publishedAt  DateTime?             @map("published_at")
  locale       String?               @default("vi") // 'vi' or 'en'
  category     Categories?           @relation(fields: [categoryId], references: [id])
  content      Content               @relation(fields: [contentId], references: [id], onDelete: Cascade)
  coverImage   StatusFeedAttachment? @relation(fields: [coverImageId], references: [id])

  @@index([categoryId])
  @@index([publishedAt])
  @@index([locale])
  @@index([slug, locale])
  @@map("posts")
}

model StatusFeed {
  id            String                 @id @default(cuid())
  contentId     String                 @unique @map("content_id")
  toolTag       String?                @map("tool_tag")
  body          String?
  privacyInt    Int                    @default(1)
  linkPreviewId String?                @map("link_preview_id")
  attachments   StatusFeedAttachment[]
  content       Content                @relation(fields: [contentId], references: [id], onDelete: Cascade)
  linkPreview   LinkPreview?           @relation(fields: [linkPreviewId], references: [id])

  @@index([toolTag])
  @@map("status_feeds")
}

model StatusFeedAttachment {
  id        String     @id @default(cuid())
  statusId  String     @map("status_id")
  mediaId   String?
  caption   String?
  order     Int?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  createdBy String?    @map("created_by")
  updatedBy String?    @map("updated_by")
  Post      Post[]
  media     Media?     @relation(fields: [mediaId], references: [id])
  status    StatusFeed @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@map("status_feed_attachments")
}

model Reaction {
  id           String            @id @default(cuid())
  userId       String
  targetType   ContentTargetType @map("target_type")
  refId        String            @map("ref_id")
  commentId    String?           @map("comment_id")
  reactionType ReactionType
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  createdBy    String?           @map("created_by")
  updatedBy    String?           @map("updated_by")
  deletedAt    DateTime?         @map("deleted_at")
  deletedBy    String?           @map("deleted_by")
  user         User              @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([refId, userId, reactionType])
  @@index([refId, targetType])
  @@map("reactions")
}

model Comment {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  refId           String            @map("ref_id")
  targetType      ContentTargetType @map("target_type")
  parentCommentId String?           @map("parent_comment_id")
  status          ContentType       @default(PUBLISHED)
  body            String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  createdBy       String?           @map("created_by")
  updatedBy       String?           @map("updated_by")
  deletedAt       DateTime?         @map("deleted_at")
  deletedBy       String?           @map("deleted_by")
  parentComment   Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]         @relation("CommentReplies")
  user            User              @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([refId, targetType])
  @@index([userId])
  @@map("comments")
}

model Share {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  refId     String   @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([refId, userId])
  @@index([refId])
  @@index([userId])
  @@map("shares")
}

model LinkPreview {
  id         String       @id @default(cuid())
  title      String
  url        String
  imageUrl   String?      @map("image_url")
  siteName   String?      @map("site_name")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  createdBy  String?      @map("created_by")
  updatedBy  String?      @map("updated_by")
  deletedAt  DateTime?    @map("deleted_at")
  deletedBy  String?      @map("deleted_by")
  StatusFeed StatusFeed[]

  @@map("link_previews")
}

model ScheduledJob {
  id          String    @id @default(cuid())
  contentId   String    @map("content_id")
  title       String?
  description String?
  scheduledAt DateTime  @map("scheduled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("scheduled_jobs")
}

model ContentTag {
  id        String  @id @default(cuid())
  contentId String  @map("content_id")
  tagId     String  @map("tag_id")
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

model NotificationEvent {
  id            String           @id @default(cuid())
  type          NotificationType
  actorId       String?          @map("actor_id")
  objectType    String?          @map("object_type")
  objectId      String?          @map("object_id")
  context       String?
  dedupeKey     String?          @map("dedupe_key")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  createdBy     String?          @map("created_by")
  updatedBy     String?          @map("updated_by")
  notifications Notifications[]

  @@index([type])
  @@index([actorId])
  @@map("notification_events")
}

model Notifications {
  id          String                 @id @default(cuid())
  recipientId String                 @map("recipient_id")
  eventId     String?                @map("event_id")
  type        NotificationType
  isRead      Boolean                @default(false) @map("is_read")
  isSeen      Boolean                @default(false) @map("is_seen")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  createdBy   String?                @map("created_by")
  updatedBy   String?                @map("updated_by")
  deliveries  NotificationDelivery[]
  event       NotificationEvent?     @relation(fields: [eventId], references: [id])
  recipient   User                   @relation(fields: [recipientId], references: [userId], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@map("notifications")
}

model NotificationDelivery {
  id             String          @id @default(cuid())
  notificationId String          @map("notification_id")
  channel        DeliveryChannel
  status         DeliveryStatus
  attempts       Int             @default(0)
  externalId     String?         @map("external_id")
  scheduledAt    DateTime?       @map("scheduled_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      String?         @map("created_by")
  updatedBy      String?         @map("updated_by")
  notification   Notifications   @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  channel   DeliveryChannel
  inApp     Boolean          @default(true)
  push      Boolean          @default(true)
  email     Boolean          @default(true)
  digest    Json?
  period    DigestPeriod?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  createdBy String?          @map("created_by")
  updatedBy String?          @map("updated_by")
  user      User             @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model NotificationDigest {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  period    DigestPeriod
  rangeFrom DateTime?    @map("range_from")
  rangeTo   DateTime?    @map("range_to")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by")
  updatedBy String?      @map("updated_by")
  user      User         @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("notification_digests")
}

model NotificationTemplate {
  id        String           @id @default(cuid())
  type      NotificationType
  channel   DeliveryChannel
  subject   String?
  body      String?
  locale    String?          @default("en")
  version   Int?             @default(1)
  status    Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  createdBy String?          @map("created_by")
  updatedBy String?          @map("updated_by")

  @@unique([type, channel, locale])
  @@index([type])
  @@index([channel])
  @@map("notification_templates")
}

model UserSettings {
  userId               String   @id @map("user_id")
  emailEnabled         Boolean  @default(true) @map("email_enabled")
  pushEnabled          Boolean  @default(true) @map("push_enabled")
  newPostFromFollowing Boolean  @default(true) @map("new_post_from_following")
  newFollower          Boolean  @default(true) @map("new_follower")
  commentOnPost        Boolean  @default(true) @map("comment_on_post")
  reactionOnPost       Boolean  @default(true) @map("reaction_on_post")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdBy            String?  @map("created_by")
  updatedBy            String?  @map("updated_by")
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_settings")
}

model PushToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  provider   String
  tokenEnc   String   @map("token_enc")
  deviceInfo String?  @map("device_info")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, provider, tokenEnc])
  @@index([userId])
  @@index([provider])
  @@map("push_tokens")
}

model Media {
  id                       String                 @id @default(cuid())
  alt                      String?
  uploadedId               String?                @map("uploaded_id")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  createdBy                String?                @map("created_by")
  updatedBy                String?                @map("updated_by")
  filename                 String
  metadata                 String?
  mimeType                 String                 @map("mime_type")
